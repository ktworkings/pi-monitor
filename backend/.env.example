# Server
PORT=3010

# Pi Network Horizon API
HORIZON_URL=https://api.mainnet.minepi.com

# Pi reserve amount (subtracted from raw balance to compute "available")
RESERVE_PI=1

# ─── Adaptive scheduler cadences (per-wallet poll interval, ms) ───
# Each wallet is classified into a tier and polled at that cadence.
#   urgent — unclaimed / <2h to unlock / never-polled / new wallets
#   soon   — <24h to unlock / errored last poll
#   normal — funded, no imminent events
#   idle   — empty accounts with no claimables
POLL_URGENT_MS=60000
POLL_SOON_MS=300000
POLL_NORMAL_MS=1800000
POLL_IDLE_MS=7200000

# ─── Worker pool + rate limiter ───
# Concurrency = number of in-flight Horizon calls (soft ceiling).
# MAX_RPS = target sustained requests/second. On 429/503/504 the limiter
# halves rps and applies exponential backoff, recovering slowly.
MAX_CONCURRENCY=25
MAX_RPS=50

# ─── Horizon SSE payment stream ───
# When enabled, opens a single global payments stream and filters
# locally by public key. On a hit, the affected wallet is re-polled
# immediately so alerts fire within seconds rather than minutes.
# Set to 'false' to fall back to polling only.
ENABLE_PAYMENT_STREAM=true

# ─── Brevo email alerts ───
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Sender (must be a verified sender in Brevo)
EMAIL_FROM_NAME=Pi Wallet Monitor
EMAIL_FROM_ADDRESS=your-verified-sender@example.com

# Recipient
EMAIL_TO=recipient@example.com

# ─── Email queue pacing ───
# Brevo's transactional API caps around ~10 rps. All alerts go through a
# paced FIFO queue so bursts (payment stream firing at once across many
# wallets) don't get 429'd. On 429, exponential backoff + auto-retry.
#   EMAIL_INTERVAL_MS — min ms between sends (250 = 4/sec, safe for all tiers)
#   EMAIL_QUEUE_MAX   — cap; oldest dropped if exceeded
#   EMAIL_MAX_RETRIES — per-message retry count on 429/5xx
EMAIL_INTERVAL_MS=250
EMAIL_QUEUE_MAX=10000
EMAIL_MAX_RETRIES=5

# ─── Dashboard credentials ───
DASH_USER=admin
DASH_PASS=password123
