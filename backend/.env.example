# Server
PORT=3010

# Pi Network Horizon API
HORIZON_URL=https://api.mainnet.minepi.com

# Pi reserve amount (subtracted from raw balance to compute "available")
RESERVE_PI=1

# ─── Adaptive scheduler cadences (per-wallet poll interval, ms) ───
# Each wallet is classified into a tier and polled at that cadence.
#   urgent — unclaimed / <2h to unlock / never-polled / new wallets
#   soon   — <24h to unlock / errored last poll
#   normal — funded, no imminent events
#   idle   — empty accounts with no claimables
POLL_URGENT_MS=60000
POLL_SOON_MS=300000
POLL_NORMAL_MS=1800000
POLL_IDLE_MS=7200000

# ─── Worker pool + rate limiter ───
# Concurrency = number of in-flight Horizon calls (soft ceiling).
# MAX_RPS = target sustained requests/second. On 429/503/504 the limiter
# halves rps and applies exponential backoff, recovering slowly.
MAX_CONCURRENCY=25
MAX_RPS=50

# ─── Horizon SSE payment stream ───
# When enabled, opens a single global payments stream and filters
# locally by public key. On a hit, the affected wallet is re-polled
# immediately so alerts fire within seconds rather than minutes.
# Set to 'false' to fall back to polling only.
ENABLE_PAYMENT_STREAM=true

# ─── Gmail SMTP email alerts ───
# 1. Enable 2-Step Verification on your Google account.
# 2. Generate an app password at: https://myaccount.google.com/apppasswords
#    (16 characters, no spaces required). This is a NON-INTERACTIVE password
#    for this app only — revoke it any time from the same page.
# 3. Put the Gmail address in GMAIL_USER and the app password in GMAIL_APP_PASSWORD.
# Gmail SMTP caps at ~500 sends/day per account. The queue paces well below that.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Display name shown to recipients
EMAIL_FROM_NAME=Pi Wallet Monitor

# Optional. Gmail SMTP rewrites the From header to GMAIL_USER unless this
# address is registered as a "Send mail as" alias in your Gmail settings.
# Leave blank to send from GMAIL_USER (recommended).
EMAIL_FROM_ADDRESS=

# Recipient (where alerts land)
EMAIL_TO=recipient@example.com

# ─── Email queue pacing ───
# Gmail may temporarily throttle bursty senders with SMTP 421. All alerts
# go through a paced FIFO queue so a spike (payment stream firing across
# many wallets at once) doesn't trip Gmail's per-account limits.
#   EMAIL_INTERVAL_MS — min ms between sends (250 = 4/sec)
#   EMAIL_QUEUE_MAX   — cap; oldest dropped if exceeded
#   EMAIL_MAX_RETRIES — per-message retry count on transient errors (4xx SMTP, network)
EMAIL_INTERVAL_MS=250
EMAIL_QUEUE_MAX=10000
EMAIL_MAX_RETRIES=5

# ─── Dashboard credentials ───
DASH_USER=admin
DASH_PASS=password123
